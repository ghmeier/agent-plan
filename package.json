{
  "name": "@ghmeier/agent-plan",
  "version": "0.8.0",
  "description": "Version-controlled plan storage for agent-driven coding workflows, without cluttering your main repo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghmeier/agent-plan.git"
  },
  "type": "module",
  "bin": {
    "agent-plan": "dist/apl.js",
    "apl": "dist/apl.js"
  },
  "files": [
    "dist/apl.js",
    "dist/THIRD_PARTY_LICENSES",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "bun test",
    "test:dist": "bun run build && APL_TEST_DIST=1 bun test --timeout 30000",
    "start": "bun run src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "build:binary": "bun build src/index.ts --compile --outfile dist/apl",
    "prepublishOnly": "bun run typecheck && bun run lint && bun test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "1.4.2",
    "commander": "^15.0.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
